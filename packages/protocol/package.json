{
  "name": "@avalon/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./mobile": {
      "types": "./src/mobile.ts",
      "react-native": "./src/mobile.ts",
      "browser": "./dist/mobile.js",
      "default": "./dist/mobile.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "tsx scripts/generate-schemas.ts",
    "generate:check": "tsx scripts/generate-schemas.ts --check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude 'src/**/*.contract.test.ts'",
    "test:contract": "vitest run protocol.contract.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
