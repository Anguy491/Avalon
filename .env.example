# Local-only values. Copy this file to .env and replace every secret value.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_DB=avalon
POSTGRES_USER=avalon
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgres://avalon:replace-with-local-database-password@127.0.0.1:5432/avalon
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_MAX=60
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
JOIN_RATE_LIMIT_MAX=5
CREATE_JOIN_IP_RATE_LIMIT=30
CREATE_JOIN_GLOBAL_RATE_LIMIT=600
SESSION_TOKEN_PEPPER=replace-with-an-independent-32-character-secret
IDEMPOTENCY_ENCRYPTION_SECRET=replace-with-another-independent-32-character-secret
SESSION_TTL_SECONDS=1800
WECHAT_APP_ID=wx0240d55d0f3e4811
WECHAT_APP_SECRET=replace-with-wechat-secret-from-production-secret-storage
WECHAT_IDENTITY_PEPPER=replace-with-an-independent-32-character-secret
# Use transition only during the bounded legacy-session migration window.
WECHAT_AUTH_ENFORCEMENT=transition
REALTIME_PUBLIC_URL=wss://localhost.invalid/game-v2
TRUSTED_PROXY_CIDRS=
HANDSHAKE_IP_RATE_LIMIT=30
PENDING_AUTH_LIMIT=100
AUTH_TIMEOUT_MS=3000
INSTANCE_CONNECTION_LIMIT=6000
GLOBAL_CONNECTION_LIMIT=12000
SESSION_SOCKET_LIMIT=2
TERMINAL_ACK_RATE_LIMIT=3
AUDIO_TELEMETRY_RATE_LIMIT=6
DATABASE_POOL_MAX=10
DATABASE_QUERY_TIMEOUT_MS=2000
OUTBOX_BATCH_SIZE=25
# Optional OTLP/HTTP protobuf metrics endpoint, normally a private Collector.
OTLP_METRICS_ENDPOINT=

# Stable mobile identity and public join host are reviewed, non-secret values.
# Preview/Production must additionally provide the pending EAS/Sentry values,
# enable verified App Links, and pass `pnpm preview:check`.
EXPO_PUBLIC_DEPLOYMENT_ENV=development
EXPO_PUBLIC_APP_NAME=曼波阿瓦隆
EXPO_PUBLIC_APP_SLUG=anguy-avalon
EXPO_PUBLIC_APP_SCHEME=anguyavalon
EXPO_PUBLIC_BUNDLE_ID=dev.anguy.avalon
EXPO_PUBLIC_JOIN_HOST=avalon.anguy.dev
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
EXPO_ENABLE_IOS_ASSOCIATED_DOMAINS=0
EXPO_APP_LINKS_VERIFIED=0
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_REVIEWED=0
