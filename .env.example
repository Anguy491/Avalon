# Local-only values. Copy this file to .env and replace every secret value.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
POSTGRES_DB=avalon
POSTGRES_USER=avalon
POSTGRES_PASSWORD=replace-with-local-database-password
DATABASE_URL=postgres://avalon:replace-with-local-database-password@127.0.0.1:5432/avalon
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_MAX=60
RATE_LIMIT_HMAC_SECRET=replace-with-at-least-32-random-characters
JOIN_RATE_LIMIT_MAX=5
SESSION_TOKEN_PEPPER=replace-with-an-independent-32-character-secret
IDEMPOTENCY_ENCRYPTION_SECRET=replace-with-another-independent-32-character-secret
SESSION_TTL_SECONDS=1800
REALTIME_PUBLIC_URL=wss://localhost.invalid/game-v1
