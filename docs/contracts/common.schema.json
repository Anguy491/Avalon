{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.example/schemas/v1/common.schema.json",
  "title": "Avalon protocol v1 common types",
  "$defs": {
    "Uuid": {
      "format": "uuid",
      "type": "string"
    },
    "RoomCode": {
      "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$",
      "type": "string"
    },
    "Nickname": {
      "minLength": 1,
      "maxLength": 16,
      "type": "string"
    },
    "SessionToken": {
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "RulesVersion": {
      "const": "CLASSIC_AVALON_V1",
      "type": "string"
    },
    "RoleId": {
      "anyOf": [
        {
          "const": "MERLIN",
          "type": "string"
        },
        {
          "const": "LOYAL_SERVANT",
          "type": "string"
        },
        {
          "const": "PERCIVAL",
          "type": "string"
        },
        {
          "const": "ASSASSIN",
          "type": "string"
        },
        {
          "const": "MINION",
          "type": "string"
        },
        {
          "const": "MORGANA",
          "type": "string"
        },
        {
          "const": "MORDRED",
          "type": "string"
        },
        {
          "const": "OBERON",
          "type": "string"
        }
      ]
    },
    "Alignment": {
      "anyOf": [
        {
          "const": "GOOD",
          "type": "string"
        },
        {
          "const": "EVIL",
          "type": "string"
        }
      ]
    },
    "GamePhase": {
      "anyOf": [
        {
          "const": "LOBBY",
          "type": "string"
        },
        {
          "const": "ROLE_REVEAL",
          "type": "string"
        },
        {
          "const": "TEAM_PROPOSAL",
          "type": "string"
        },
        {
          "const": "TEAM_VOTE",
          "type": "string"
        },
        {
          "const": "QUEST_SUBMISSION",
          "type": "string"
        },
        {
          "const": "QUEST_RESOLUTION",
          "type": "string"
        },
        {
          "const": "ASSASSINATION",
          "type": "string"
        },
        {
          "const": "GAME_OVER",
          "type": "string"
        },
        {
          "const": "PAUSED",
          "type": "string"
        }
      ]
    },
    "PhaseStage": {
      "anyOf": [
        {
          "const": "HOST_HELD",
          "type": "string"
        },
        {
          "const": "COLLECTING",
          "type": "string"
        },
        {
          "const": "RESOLVED",
          "type": "string"
        }
      ]
    },
    "TeamVote": {
      "anyOf": [
        {
          "const": "APPROVE",
          "type": "string"
        },
        {
          "const": "REJECT",
          "type": "string"
        }
      ]
    },
    "QuestChoice": {
      "anyOf": [
        {
          "const": "SUCCESS",
          "type": "string"
        },
        {
          "const": "FAIL",
          "type": "string"
        }
      ]
    },
    "PauseTerminationChoice": {
      "anyOf": [
        {
          "const": "TERMINATE",
          "type": "string"
        },
        {
          "const": "CONTINUE_PAUSE",
          "type": "string"
        }
      ]
    },
    "QuestResult": {
      "anyOf": [
        {
          "const": "SUCCESS",
          "type": "string"
        },
        {
          "const": "FAILURE",
          "type": "string"
        }
      ]
    },
    "Winner": {
      "anyOf": [
        {
          "const": "GOOD",
          "type": "string"
        },
        {
          "const": "EVIL",
          "type": "string"
        },
        {
          "const": "NONE",
          "type": "string"
        }
      ]
    },
    "GameOutcomeReason": {
      "anyOf": [
        {
          "const": "THREE_QUEST_FAILURES",
          "type": "string"
        },
        {
          "const": "FIVE_REJECTED_TEAMS",
          "type": "string"
        },
        {
          "const": "MERLIN_ASSASSINATED",
          "type": "string"
        },
        {
          "const": "MERLIN_SURVIVED",
          "type": "string"
        },
        {
          "const": "ABORTED",
          "type": "string"
        }
      ]
    },
    "CommandType": {
      "anyOf": [
        {
          "const": "ConfigureRoom",
          "type": "string"
        },
        {
          "const": "ReorderSeats",
          "type": "string"
        },
        {
          "const": "SetReady",
          "type": "string"
        },
        {
          "const": "StartGame",
          "type": "string"
        },
        {
          "const": "ContinuePhase",
          "type": "string"
        },
        {
          "const": "AckRole",
          "type": "string"
        },
        {
          "const": "SubmitTeam",
          "type": "string"
        },
        {
          "const": "SubmitTeamVote",
          "type": "string"
        },
        {
          "const": "SubmitQuestChoice",
          "type": "string"
        },
        {
          "const": "SelectMerlinTarget",
          "type": "string"
        },
        {
          "const": "PauseGame",
          "type": "string"
        },
        {
          "const": "ResumeGame",
          "type": "string"
        },
        {
          "const": "StartPauseTerminationVote",
          "type": "string"
        },
        {
          "const": "SubmitPauseTerminationVote",
          "type": "string"
        },
        {
          "const": "ReplayAudioCue",
          "type": "string"
        },
        {
          "const": "LeaveLobby",
          "type": "string"
        },
        {
          "const": "KickLobbyPlayer",
          "type": "string"
        },
        {
          "const": "CloseRoom",
          "type": "string"
        }
      ]
    },
    "ErrorCode": {
      "anyOf": [
        {
          "const": "INVALID_ROOM_CODE",
          "type": "string"
        },
        {
          "const": "ROOM_FULL",
          "type": "string"
        },
        {
          "const": "ROOM_NOT_JOINABLE",
          "type": "string"
        },
        {
          "const": "ROOM_EXPIRED",
          "type": "string"
        },
        {
          "const": "SESSION_INVALID",
          "type": "string"
        },
        {
          "const": "NICKNAME_CONFLICT",
          "type": "string"
        },
        {
          "const": "INVALID_NICKNAME",
          "type": "string"
        },
        {
          "const": "NOT_HOST",
          "type": "string"
        },
        {
          "const": "NOT_LEADER",
          "type": "string"
        },
        {
          "const": "NOT_ASSASSIN",
          "type": "string"
        },
        {
          "const": "INVALID_PHASE",
          "type": "string"
        },
        {
          "const": "INVALID_PHASE_STAGE",
          "type": "string"
        },
        {
          "const": "PHASE_HELD",
          "type": "string"
        },
        {
          "const": "STALE_VERSION",
          "type": "string"
        },
        {
          "const": "DUPLICATE_COMMAND_CONFLICT",
          "type": "string"
        },
        {
          "const": "INVALID_CONFIG",
          "type": "string"
        },
        {
          "const": "INVALID_SEAT_ORDER",
          "type": "string"
        },
        {
          "const": "INVALID_TEAM_SIZE",
          "type": "string"
        },
        {
          "const": "INVALID_TEAM_MEMBER",
          "type": "string"
        },
        {
          "const": "INVALID_VOTE",
          "type": "string"
        },
        {
          "const": "INVALID_TARGET",
          "type": "string"
        },
        {
          "const": "PLAYER_NOT_ON_TEAM",
          "type": "string"
        },
        {
          "const": "GOOD_CANNOT_FAIL",
          "type": "string"
        },
        {
          "const": "ALREADY_SUBMITTED",
          "type": "string"
        },
        {
          "const": "HOST_CANNOT_LEAVE",
          "type": "string"
        },
        {
          "const": "PLAYERS_NOT_READY",
          "type": "string"
        },
        {
          "const": "PLAYERS_OFFLINE",
          "type": "string"
        },
        {
          "const": "AUDIO_CUE_NOT_FOUND",
          "type": "string"
        },
        {
          "const": "INVALID_PAUSE_REASON",
          "type": "string"
        },
        {
          "const": "PAUSE_VOTE_NOT_AVAILABLE",
          "type": "string"
        },
        {
          "const": "PAUSE_VOTE_NOT_ELIGIBLE",
          "type": "string"
        },
        {
          "const": "PAUSE_VOTE_CLOSED",
          "type": "string"
        },
        {
          "const": "UPGRADE_REQUIRED",
          "type": "string"
        },
        {
          "const": "RATE_LIMITED",
          "type": "string"
        },
        {
          "const": "VALIDATION_ERROR",
          "type": "string"
        },
        {
          "const": "PAYLOAD_TOO_LARGE",
          "type": "string"
        },
        {
          "const": "UNAUTHORIZED",
          "type": "string"
        },
        {
          "const": "INTERNAL_ERROR",
          "type": "string"
        }
      ]
    }
  }
}
