{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.example/schemas/v1/command.schema.json",
  "title": "Avalon realtime command envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "roomId",
    "expectedStateVersion",
    "type",
    "payload",
    "sentAt"
  ],
  "properties": {
    "commandId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "roomId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "expectedStateVersion": {
      "type": "integer",
      "minimum": 0
    },
    "type": { "$ref": "common.schema.json#/$defs/CommandType" },
    "payload": { "type": "object" },
    "sentAt": { "type": "string", "format": "date-time" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "ConfigureRoom" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["config"],
          "properties": {
            "config": {
              "$ref": "room-config.schema.json#/$defs/RoomConfigInput"
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "ReorderSeats" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playerIds"],
          "properties": {
            "playerIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/Uuid" }
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "SetReady" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ready"],
          "properties": { "ready": { "type": "boolean" } }
        }
      }
    },
    {
      "properties": {
        "type": {
          "enum": [
            "StartGame",
            "ContinuePhase",
            "AckRole",
            "ResumeGame",
            "LeaveLobby",
            "CloseRoom"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        }
      }
    },
    {
      "properties": {
        "type": { "const": "SubmitTeam" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["teamPlayerIds"],
          "properties": {
            "teamPlayerIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/Uuid" }
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "SubmitTeamVote" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vote"],
          "properties": {
            "vote": { "$ref": "common.schema.json#/$defs/TeamVote" }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "SubmitQuestChoice" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["choice"],
          "properties": {
            "choice": { "$ref": "common.schema.json#/$defs/QuestChoice" }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "SelectMerlinTarget" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetPlayerId"],
          "properties": {
            "targetPlayerId": { "$ref": "common.schema.json#/$defs/Uuid" }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "PauseGame" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "ReplayAudioCue" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audioCueId"],
          "properties": {
            "audioCueId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "KickLobbyPlayer" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetPlayerId"],
          "properties": {
            "targetPlayerId": { "$ref": "common.schema.json#/$defs/Uuid" }
          }
        }
      }
    }
  ]
}

