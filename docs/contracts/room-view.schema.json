{
  "additionalProperties": false,
  "type": "object",
  "required": [
    "public",
    "private"
  ],
  "properties": {
    "public": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "roomId",
        "roomCode",
        "stateVersion",
        "rulesVersion",
        "config",
        "phase",
        "phaseStage",
        "players",
        "proposalAttempt",
        "requiredQuestFails",
        "proposedTeamPlayerIds",
        "proposalHistory",
        "questHistory",
        "successCount",
        "failureCount",
        "pauseReasons",
        "manualPauseReason",
        "recoveryStartedAt",
        "recoveryExpiresAt"
      ],
      "properties": {
        "roomId": {
          "format": "uuid",
          "type": "string"
        },
        "roomCode": {
          "pattern": "^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{6}$",
          "type": "string"
        },
        "stateVersion": {
          "minimum": 0,
          "type": "integer"
        },
        "rulesVersion": {
          "const": "CLASSIC_AVALON_V1",
          "type": "string"
        },
        "config": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "rulesVersion",
            "playerCount",
            "roleIds",
            "locale",
            "voicePackVersion"
          ],
          "properties": {
            "rulesVersion": {
              "const": "CLASSIC_AVALON_V1",
              "type": "string"
            },
            "playerCount": {
              "minimum": 5,
              "maximum": 10,
              "type": "integer"
            },
            "roleIds": {
              "minItems": 5,
              "maxItems": 10,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "const": "MERLIN",
                    "type": "string"
                  },
                  {
                    "const": "LOYAL_SERVANT",
                    "type": "string"
                  },
                  {
                    "const": "PERCIVAL",
                    "type": "string"
                  },
                  {
                    "const": "ASSASSIN",
                    "type": "string"
                  },
                  {
                    "const": "MINION",
                    "type": "string"
                  },
                  {
                    "const": "MORGANA",
                    "type": "string"
                  },
                  {
                    "const": "MORDRED",
                    "type": "string"
                  },
                  {
                    "const": "OBERON",
                    "type": "string"
                  }
                ]
              }
            },
            "locale": {
              "const": "zh-CN",
              "type": "string"
            },
            "voicePackVersion": {
              "pattern": "^zh-CN-v[1-9][0-9]*$",
              "type": "string"
            }
          }
        },
        "phase": {
          "anyOf": [
            {
              "const": "LOBBY",
              "type": "string"
            },
            {
              "const": "ROLE_REVEAL",
              "type": "string"
            },
            {
              "const": "TEAM_PROPOSAL",
              "type": "string"
            },
            {
              "const": "TEAM_VOTE",
              "type": "string"
            },
            {
              "const": "QUEST_SUBMISSION",
              "type": "string"
            },
            {
              "const": "QUEST_RESOLUTION",
              "type": "string"
            },
            {
              "const": "ASSASSINATION",
              "type": "string"
            },
            {
              "const": "GAME_OVER",
              "type": "string"
            },
            {
              "const": "PAUSED",
              "type": "string"
            }
          ]
        },
        "phaseStage": {
          "anyOf": [
            {
              "const": "HOST_HELD",
              "type": "string"
            },
            {
              "const": "COLLECTING",
              "type": "string"
            },
            {
              "const": "RESOLVED",
              "type": "string"
            }
          ]
        },
        "players": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "playerId",
              "nickname",
              "seat",
              "isHost",
              "ready",
              "connected"
            ],
            "properties": {
              "playerId": {
                "format": "uuid",
                "type": "string"
              },
              "nickname": {
                "minLength": 1,
                "maxLength": 16,
                "type": "string"
              },
              "seat": {
                "minimum": 0,
                "maximum": 9,
                "type": "integer"
              },
              "isHost": {
                "type": "boolean"
              },
              "ready": {
                "type": "boolean"
              },
              "connected": {
                "type": "boolean"
              }
            }
          }
        },
        "leaderPlayerId": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "questIndex": {
          "anyOf": [
            {
              "minimum": 1,
              "maximum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposalAttempt": {
          "minimum": 1,
          "maximum": 5,
          "type": "integer"
        },
        "requiredTeamSize": {
          "anyOf": [
            {
              "minimum": 2,
              "maximum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredQuestFails": {
          "anyOf": [
            {
              "minimum": 1,
              "maximum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposedTeamPlayerIds": {
          "maxItems": 5,
          "uniqueItems": true,
          "type": "array",
          "items": {
            "format": "uuid",
            "type": "string"
          }
        },
        "submissionProgress": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "submittedCount",
                "requiredCount"
              ],
              "properties": {
                "submittedCount": {
                  "minimum": 0,
                  "maximum": 10,
                  "type": "integer"
                },
                "requiredCount": {
                  "minimum": 1,
                  "maximum": 10,
                  "type": "integer"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "proposalHistory": {
          "maxItems": 25,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "questIndex",
              "proposalAttempt",
              "leaderPlayerId",
              "teamPlayerIds",
              "votes",
              "approveCount",
              "rejectCount",
              "approved"
            ],
            "properties": {
              "questIndex": {
                "minimum": 1,
                "maximum": 5,
                "type": "integer"
              },
              "proposalAttempt": {
                "minimum": 1,
                "maximum": 5,
                "type": "integer"
              },
              "leaderPlayerId": {
                "format": "uuid",
                "type": "string"
              },
              "teamPlayerIds": {
                "minItems": 2,
                "maxItems": 5,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "votes": {
                "minItems": 5,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "playerId",
                    "vote"
                  ],
                  "properties": {
                    "playerId": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "vote": {
                      "anyOf": [
                        {
                          "const": "APPROVE",
                          "type": "string"
                        },
                        {
                          "const": "REJECT",
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              },
              "approveCount": {
                "minimum": 0,
                "maximum": 10,
                "type": "integer"
              },
              "rejectCount": {
                "minimum": 0,
                "maximum": 10,
                "type": "integer"
              },
              "approved": {
                "type": "boolean"
              }
            }
          }
        },
        "questHistory": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "questIndex",
              "leaderPlayerId",
              "teamPlayerIds",
              "successChoices",
              "failChoices",
              "requiredFails",
              "result"
            ],
            "properties": {
              "questIndex": {
                "minimum": 1,
                "maximum": 5,
                "type": "integer"
              },
              "leaderPlayerId": {
                "format": "uuid",
                "type": "string"
              },
              "teamPlayerIds": {
                "minItems": 2,
                "maxItems": 5,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "format": "uuid",
                  "type": "string"
                }
              },
              "successChoices": {
                "minimum": 0,
                "maximum": 5,
                "type": "integer"
              },
              "failChoices": {
                "minimum": 0,
                "maximum": 5,
                "type": "integer"
              },
              "requiredFails": {
                "minimum": 1,
                "maximum": 2,
                "type": "integer"
              },
              "result": {
                "anyOf": [
                  {
                    "const": "SUCCESS",
                    "type": "string"
                  },
                  {
                    "const": "FAILURE",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "successCount": {
          "minimum": 0,
          "maximum": 3,
          "type": "integer"
        },
        "failureCount": {
          "minimum": 0,
          "maximum": 3,
          "type": "integer"
        },
        "pauseReasons": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "const": "MANUAL",
                "type": "string"
              },
              {
                "const": "PLAYER_DISCONNECTED",
                "type": "string"
              },
              {
                "const": "HOST_DISCONNECTED",
                "type": "string"
              }
            ]
          }
        },
        "manualPauseReason": {
          "anyOf": [
            {
              "minLength": 1,
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryStartedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recoveryExpiresAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pauseTerminationVoteAvailableAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "pauseTerminationVote": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "startedAt",
                "expiresAt",
                "eligibleCount",
                "submittedCount"
              ],
              "properties": {
                "startedAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "expiresAt": {
                  "format": "date-time",
                  "type": "string"
                },
                "eligibleCount": {
                  "minimum": 1,
                  "maximum": 10,
                  "type": "integer"
                },
                "submittedCount": {
                  "minimum": 0,
                  "maximum": 10,
                  "type": "integer"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "currentAudioCue": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "audioCueId",
                "audioCueKey",
                "subtitleKey",
                "voicePackVersion"
              ],
              "properties": {
                "audioCueId": {
                  "minLength": 1,
                  "maxLength": 80,
                  "type": "string"
                },
                "audioCueKey": {
                  "pattern": "^[a-z0-9]+(?:[.][a-z0-9]+)*$",
                  "type": "string"
                },
                "subtitleKey": {
                  "pattern": "^[a-z0-9]+(?:[.][a-z0-9]+)*$",
                  "type": "string"
                },
                "voicePackVersion": {
                  "pattern": "^zh-CN-v[1-9][0-9]*$",
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "gameOutcome": {
          "anyOf": [
            {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "winner",
                "reason"
              ],
              "properties": {
                "winner": {
                  "anyOf": [
                    {
                      "const": "GOOD",
                      "type": "string"
                    },
                    {
                      "const": "EVIL",
                      "type": "string"
                    },
                    {
                      "const": "NONE",
                      "type": "string"
                    }
                  ]
                },
                "reason": {
                  "anyOf": [
                    {
                      "const": "THREE_QUEST_FAILURES",
                      "type": "string"
                    },
                    {
                      "const": "FIVE_REJECTED_TEAMS",
                      "type": "string"
                    },
                    {
                      "const": "MERLIN_ASSASSINATED",
                      "type": "string"
                    },
                    {
                      "const": "MERLIN_SURVIVED",
                      "type": "string"
                    },
                    {
                      "const": "ABORTED",
                      "type": "string"
                    }
                  ]
                },
                "assassinationTargetPlayerId": {
                  "anyOf": [
                    {
                      "format": "uuid",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "revealedAssignments": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "playerId",
              "roleId",
              "alignment"
            ],
            "properties": {
              "playerId": {
                "format": "uuid",
                "type": "string"
              },
              "roleId": {
                "anyOf": [
                  {
                    "const": "MERLIN",
                    "type": "string"
                  },
                  {
                    "const": "LOYAL_SERVANT",
                    "type": "string"
                  },
                  {
                    "const": "PERCIVAL",
                    "type": "string"
                  },
                  {
                    "const": "ASSASSIN",
                    "type": "string"
                  },
                  {
                    "const": "MINION",
                    "type": "string"
                  },
                  {
                    "const": "MORGANA",
                    "type": "string"
                  },
                  {
                    "const": "MORDRED",
                    "type": "string"
                  },
                  {
                    "const": "OBERON",
                    "type": "string"
                  }
                ]
              },
              "alignment": {
                "anyOf": [
                  {
                    "const": "GOOD",
                    "type": "string"
                  },
                  {
                    "const": "EVIL",
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "private": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "playerId",
        "knownPlayers",
        "availableActions",
        "hasSubmitted",
        "shouldPlayAudio",
        "sessionExpiresAt"
      ],
      "properties": {
        "playerId": {
          "format": "uuid",
          "type": "string"
        },
        "selfRole": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "MERLIN",
                  "type": "string"
                },
                {
                  "const": "LOYAL_SERVANT",
                  "type": "string"
                },
                {
                  "const": "PERCIVAL",
                  "type": "string"
                },
                {
                  "const": "ASSASSIN",
                  "type": "string"
                },
                {
                  "const": "MINION",
                  "type": "string"
                },
                {
                  "const": "MORGANA",
                  "type": "string"
                },
                {
                  "const": "MORDRED",
                  "type": "string"
                },
                {
                  "const": "OBERON",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "selfAlignment": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "const": "GOOD",
                  "type": "string"
                },
                {
                  "const": "EVIL",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "knownPlayers": {
          "maxItems": 9,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "playerId",
              "knowledgeLabel"
            ],
            "properties": {
              "playerId": {
                "format": "uuid",
                "type": "string"
              },
              "knowledgeLabel": {
                "anyOf": [
                  {
                    "const": "EVIL_PLAYER",
                    "type": "string"
                  },
                  {
                    "const": "MERLIN_CANDIDATE",
                    "type": "string"
                  },
                  {
                    "const": "KNOWN_EVIL_ALLY",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "availableActions": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "commandType"
            ],
            "properties": {
              "commandType": {
                "anyOf": [
                  {
                    "const": "ConfigureRoom",
                    "type": "string"
                  },
                  {
                    "const": "ReorderSeats",
                    "type": "string"
                  },
                  {
                    "const": "SetReady",
                    "type": "string"
                  },
                  {
                    "const": "StartGame",
                    "type": "string"
                  },
                  {
                    "const": "ContinuePhase",
                    "type": "string"
                  },
                  {
                    "const": "AckRole",
                    "type": "string"
                  },
                  {
                    "const": "SubmitTeam",
                    "type": "string"
                  },
                  {
                    "const": "SubmitTeamVote",
                    "type": "string"
                  },
                  {
                    "const": "SubmitQuestChoice",
                    "type": "string"
                  },
                  {
                    "const": "SelectMerlinTarget",
                    "type": "string"
                  },
                  {
                    "const": "PauseGame",
                    "type": "string"
                  },
                  {
                    "const": "ResumeGame",
                    "type": "string"
                  },
                  {
                    "const": "StartPauseTerminationVote",
                    "type": "string"
                  },
                  {
                    "const": "SubmitPauseTerminationVote",
                    "type": "string"
                  },
                  {
                    "const": "ReplayAudioCue",
                    "type": "string"
                  },
                  {
                    "const": "LeaveLobby",
                    "type": "string"
                  },
                  {
                    "const": "KickLobbyPlayer",
                    "type": "string"
                  },
                  {
                    "const": "CloseRoom",
                    "type": "string"
                  }
                ]
              },
              "allowedTeamVotes": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "const": "APPROVE",
                      "type": "string"
                    },
                    {
                      "const": "REJECT",
                      "type": "string"
                    }
                  ]
                }
              },
              "allowedQuestChoices": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "const": "SUCCESS",
                      "type": "string"
                    },
                    {
                      "const": "FAIL",
                      "type": "string"
                    }
                  ]
                }
              },
              "allowedPauseTerminationChoices": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "const": "TERMINATE",
                      "type": "string"
                    },
                    {
                      "const": "CONTINUE_PAUSE",
                      "type": "string"
                    }
                  ]
                }
              },
              "eligibleTargetPlayerIds": {
                "maxItems": 9,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          }
        },
        "hasSubmitted": {
          "type": "boolean"
        },
        "pauseTerminationVoteStatus": {
          "anyOf": [
            {
              "const": "NOT_ELIGIBLE",
              "type": "string"
            },
            {
              "const": "PENDING",
              "type": "string"
            },
            {
              "const": "SUBMITTED",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "shouldPlayAudio": {
          "type": "boolean"
        },
        "sessionExpiresAt": {
          "format": "date-time",
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://avalon.example/schemas/v2/room-view.schema.json",
  "title": "Avalon personalized room view"
}
