{
  "name": "@avalon/wechat-mini",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm run build:weapp",
    "prebuild:weapp": "pnpm --filter @avalon/protocol build && pnpm --filter @avalon/client-core build",
    "build:weapp": "taro build --type weapp",
    "prebuild:weapp:release": "pnpm --filter @avalon/protocol build && pnpm --filter @avalon/client-core build && node ../../scripts/generate-audio-pack.mjs --check --verify-assets",
    "build:weapp:release": "TARO_APP_BUILD_PROFILE=release node scripts/validate-release-config.mjs && TARO_APP_BUILD_PROFILE=release taro build --type weapp && TARO_APP_BUILD_PROFILE=release node scripts/validate-release-config.mjs --check-output",
    "postbuild:weapp": "node scripts/check-runtime-compat.mjs",
    "dev": "pnpm run dev:weapp",
    "predev:weapp": "pnpm --filter @avalon/protocol build && pnpm --filter @avalon/client-core build",
    "dev:weapp": "taro build --type weapp --watch",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:preview": "node scripts/run-preview-e2e.mjs",
    "test:runtime": "node scripts/check-runtime-compat.mjs",
    "test:size": "node scripts/check-package-size.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@avalon/client-core": "workspace:*",
    "@avalon/protocol": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "engine.io-client": "6.6.6",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/taro-loader": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/qrcode-generator": "1.0.6",
    "@types/react": "18.3.24",
    "@types/webpack-env": "1.18.8",
    "babel-preset-taro": "4.2.1",
    "miniprogram-automator": "0.12.1",
    "sass": "1.103.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "webpack": "5.110.2"
  }
}
